# Path to the Google service account JSON key file.
# The service account needs Editor access to the Accounting/1.Sales folder
# (share that folder with the service account's email address).
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# ID of the "Accounting/1.Sales" folder itself (the long string in its
# Drive URL after /folders/). Year (YYYY) and month (MM) subfolders under
# it are found-or-created automatically -- no need to pre-create them.
DRIVE_SALES_FOLDER_ID=

# Port the service listens on (uvicorn main:app --port $PORT)
PORT=8000
